[Unit]
Description=Private SUUR proposal ingress for the Hermes grace profile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grace
Group=grace
EnvironmentFile=/etc/suur-grace-ingress.env
Environment=HOME=/home/grace HERMES_HOME=/home/grace/.hermes/profiles/grace
ExecStart=/usr/bin/python3 /opt/suur-things-mcp/scripts/grace_hermes_ingress.py --host 127.0.0.1 --port ${GRACE_INGRESS_PORT} --shared-key-file ${GRACE_SHARED_KEY_FILE} --spool-dir /var/lib/suur-grace-ingress/proposals --hermes-home /home/grace/.hermes/profiles/grace --hermes-bin ${GRACE_HERMES_BIN} --hermes-install-root ${GRACE_HERMES_INSTALL_ROOT} --timeout-seconds 30
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/suur-grace-ingress
ReadWritePaths=/home/grace/.hermes/profiles/grace
StateDirectory=suur-grace-ingress
UMask=0077

[Install]
WantedBy=multi-user.target
