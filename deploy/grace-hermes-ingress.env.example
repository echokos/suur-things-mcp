# Install as /etc/suur-grace-ingress.env with mode 0600. Paths are not secret;
# the HMAC key remains only in the referenced regular 0600 file.
GRACE_INGRESS_PORT=8790
GRACE_SHARED_KEY_FILE=/etc/suur-grace-ingress/grace-shared-key
# Both paths must be absolute and name the same secured Hermes installation.
# venv/bin/python3 must be a copied, regular CPython binary -- never a symlink
# or shell wrapper. The root and its runtime files must not be group- or
# world-writable.
GRACE_HERMES_INSTALL_ROOT=/opt/hermes
GRACE_HERMES_BIN=/opt/hermes/bin/hermes
